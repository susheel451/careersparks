# ============================================================
# Career Spark — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Cloudinary ──────────────────────────────────────────────
# Your Cloudinary Cloud Name (visible in the Cloudinary dashboard).
# This is a PUBLIC value — safe to expose in browser code.
CLOUDINARY_CLOUD_NAME=

# Your Cloudinary API Key.
# PUBLIC — safe in browser code (not a secret by itself).
CLOUDINARY_API_KEY=

# Your Cloudinary API Secret.
# PRIVATE — NEVER put this in any HTML, CSS or JS that is served
# to the browser. Only use it in server-side scripts (e.g. the
# upload helper in scripts/upload.mjs).
CLOUDINARY_API_SECRET=

# ── Enquiry form ─────────────────────────────────────────────
# Paste the full POST endpoint from your chosen form service
# (e.g. Formspree: https://formspree.io/f/XXXXXXXX,
#  or Web3Forms:   https://api.web3forms.com/submit).
# Leave empty to fall back to the SMS-compose behaviour.
ENQUIRY_FORM_ENDPOINT=
